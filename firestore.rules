rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }
    function isRoomMember(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid));
    }
    function myRoomRole(roomId) {
      return get(memberPath(roomId, request.auth.uid)).data.role;
    }
    function canEditRoomSettings(roomId) {
      return isRoomMember(roomId) && myRoomRole(roomId) in ['owner', 'editor'];
    }
    function isRoomOwner(roomId) {
      return isRoomMember(roomId) && myRoomRole(roomId) == 'owner';
    }
    function isAppAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/appAdmins/$(request.auth.uid));
    }
    match /bossSchedules/{bossId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['anchorMs', 'intervalMinutes', 'weekdays', 'minuteOfDay', 'updatedAt'])
        && (request.resource.data.anchorMs == null ||
            (request.resource.data.anchorMs is int && request.resource.data.anchorMs > 0
             && request.resource.data.anchorMs <= request.time.toMillis()))
        && request.resource.data.intervalMinutes is int
        && request.resource.data.intervalMinutes >= 0
        && request.resource.data.intervalMinutes <= 525600
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() <= 7
        && request.resource.data.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && (request.resource.data.weekdays.size() > 0 || request.resource.data.intervalMinutes > 5)
        && request.resource.data.minuteOfDay is int
        && request.resource.data.minuteOfDay >= 0 && request.resource.data.minuteOfDay < 1440
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;
    }
    match /bossAlarmUsers/{userId}/schedules/current {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'bosses', 'enabledBosses', 'quietEnabled',
          'quietStartMinute', 'quietEndMinute', 'uid', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['schemaVersion']) ||
            request.resource.data.schemaVersion == 1)
        && (!request.resource.data.keys().hasAny(['bosses']) ||
            (request.resource.data.bosses is list &&
             request.resource.data.bosses.size() <= 100))
        && (!request.resource.data.keys().hasAny(['quietEnabled']) ||
            request.resource.data.quietEnabled is bool)
        && (!request.resource.data.keys().hasAny(['quietStartMinute']) ||
            (request.resource.data.quietStartMinute is int &&
             request.resource.data.quietStartMinute >= 0 &&
             request.resource.data.quietStartMinute < 1440))
        && (!request.resource.data.keys().hasAny(['quietEndMinute']) ||
            (request.resource.data.quietEndMinute is int &&
             request.resource.data.quietEndMinute >= 0 &&
             request.resource.data.quietEndMinute < 1440));
    }

    match /appPopups/{popupId} {
      allow read: if request.auth != null;
      allow create, update: if isAppAdmin()
        && request.resource.data.keys().hasOnly([
          'enabled', 'title', 'message', 'version', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.version is string
        && request.resource.data.version.size() > 0
        && request.resource.data.version.size() <= 80
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /appAdmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name', 'title', 'world', 'worldName', 'serverNo', 'ownerUid', 'hasPassword',
          'passwordHash', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.world in ['dien', 'lindriss', 'ulan', 'garbana']
        && request.resource.data.worldName in ['디엔', '린드리스', '울란', '가르바나']
        && request.resource.data.serverNo is int
        && request.resource.data.serverNo >= 1
        && request.resource.data.serverNo <= 10
        && request.resource.data.hasPassword is bool
        && (request.resource.data.passwordHash == null ||
            request.resource.data.passwordHash is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isRoomOwner(roomId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'title', 'ownerUid', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!request.resource.data.keys().hasAny(['title']) ||
            (request.resource.data.title is string &&
             request.resource.data.title.size() > 0 &&
             request.resource.data.title.size() <= 60))
        && request.resource.data.ownerUid is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /members/{userId} {
        allow read: if isRoomMember(roomId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'role', 'pushEnabled', 'joinedAt', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['member', 'owner']
          && (request.resource.data.role == 'member' ||
              getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid)
          && request.resource.data.pushEnabled is bool
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn()
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'role', 'pushEnabled', 'joinedAt', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.pushEnabled is bool
          && request.resource.data.updatedAt == request.time
          && (
            (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'pushEnabled', 'updatedAt'])) ||
            (isRoomOwner(roomId) && request.resource.data.role in ['member', 'editor', 'owner'])
          );
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /memberSettings/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid', 'enabledBosses', 'quietEnabled', 'quietStartMinute',
            'quietEndMinute', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.keys().hasAny(['quietEnabled']) ||
              request.resource.data.quietEnabled is bool)
          && (!request.resource.data.keys().hasAny(['quietStartMinute']) ||
              (request.resource.data.quietStartMinute is int &&
               request.resource.data.quietStartMinute >= 0 &&
               request.resource.data.quietStartMinute < 1440))
          && (!request.resource.data.keys().hasAny(['quietEndMinute']) ||
              (request.resource.data.quietEndMinute is int &&
               request.resource.data.quietEndMinute >= 0 &&
               request.resource.data.quietEndMinute < 1440));
        allow delete: if false;
      }

      match /bossSchedules/{bossId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
          && request.resource.data.keys().hasAll([
            'id', 'name', 'region', 'location', 'intervalMinutes',
            'weekdays', 'minuteOfDay', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if canEditRoomSettings(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['anchorMs', 'intervalMinutes', 'weekdays', 'minuteOfDay', 'updatedAt', 'updatedBy'])
          && (request.resource.data.anchorMs == null ||
              (request.resource.data.anchorMs is int && request.resource.data.anchorMs > 0
               && request.resource.data.anchorMs <= request.time.toMillis()))
          && request.resource.data.intervalMinutes is int
          && request.resource.data.intervalMinutes >= 0
          && request.resource.data.intervalMinutes <= 525600
          && request.resource.data.weekdays is list
          && request.resource.data.weekdays.size() <= 7
          && request.resource.data.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
          && (request.resource.data.weekdays.size() > 0 || request.resource.data.intervalMinutes > 5)
          && request.resource.data.minuteOfDay is int
          && request.resource.data.minuteOfDay >= 0 && request.resource.data.minuteOfDay < 1440
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'text', 'type', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.type in ['text', 'system', 'boss_update']
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
